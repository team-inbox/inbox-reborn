{
  "name": "Inbox Reborn theme for Gmail™",
  "version": "2.5.1",
  "default_locale": "en",
  "manifest_version": 2,
  "permissions": ["storage"],
  "description": "Adds features like reminders, email bundling, and Inbox's minimalistic style to Gmail™",
  "homepage_url": "https://github.com/team-inbox/inbox-reborn",
  "browser_specific_settings": {
    "gecko": {
      "id": "inbox-reborn-new@team-inbox.github.io",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "browser_action": {
    "default_popup": "src/options/options.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false,
    "browser_style": false
  },
  "background": {
    "scripts": ["src/background.js"],
    "persistent": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/mail/*"],
      "css": ["src/style.css"],
      "js": [
        "src/content/instance.js",
        "src/content/dark-mode.js",
        "src/content/core.js",
        "src/content/emails.js",
        "src/content/bundles.js",
        "src/content/options.js",
        "src/content/inbox.js",
        "src/content/left-menu.js",
        "src/content/label-sections.js",
        "src/content/row-actions.js",
        "src/content/ui.js",
        "src/content/contacts.js",
        "src/content/avatars.js",
        "src/content/init.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": ["images/*", "src/gmail-categories.js"]
}
